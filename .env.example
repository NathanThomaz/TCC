# Copie para .env (que não é versionado) e ajuste os valores.

# Fase da coleta: "piloto" ou "principal". Cada fase grava os dados em data/raw/<fase>/.
TCC_FASE=piloto

# Diretório com os pacotes de tarefas da fase principal (selados, FORA do repositório).
# Na fase piloto, o padrão é experiment/tasks/piloto.
# TCC_TAREFAS_DIR=D:/tcc-selado/tarefas

# Plano de randomização usado na fase (padrão: experiment/randomization/plano-<fase>.csv).
# TCC_PLANO=

# Onde ficam os workspaces de execução (padrão: ../tcc-workspaces, fora do repositório).
# TCC_WORKSPACES=

# Chaves de API: o instrumento NÃO chama nenhuma API de IA. Nunca coloque chaves neste repositório.
