# Copie este arquivo para ".env" e preencha com suas credenciais.
# NUNCA versionar o arquivo ".env" com chaves reais (ver .gitignore).

# --- API Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_PAIS=br
# Restringe a coleta à área de tecnologia (ver categorias em /v1/api/jobs/{pais}/categories)
ADZUNA_CATEGORIA_ALVO=it-jobs

# --- API IBGE (https://servicodados.ibge.gov.br/api/docs) ---
# Serviço público, não exige chave de autenticação.
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api

# --- Airflow (Docker Compose) ---
AIRFLOW_UID=50000
