{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexus",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },

  // Um único Worker (ADR-001 do TCC): o React é servido como Static Assets e só /api/* executa o
  // Worker. Rotas da SPA (deep links) caem no index.html; /api/* nunca.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  // Ambiente padrão = desenvolvimento local, só com dados fictícios.
  "vars": {
    "APP_ENV": "development",
    "CADASTRO_ABERTO": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-dev",
      // Local: qualquer UUID serve. Remoto: id de `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Produção (DEC do TCC: deploy e migrations autorizados após merge com CI verde): workers.dev,
  // D1 nexus-prod, projeto Firebase nexus-tcc-2026. Segredos via `wrangler secret put --env
  // production`: FIREBASE_SERVICE_ACCOUNT e FIREBASE_WEB_API_KEY (pública, mas fora do Git).
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        // Cadastro aberto com e-mail confirmado (ADR-009); "false" fecha sem mudar o código.
        "CADASTRO_ABERTO": "true",
        "FIREBASE_PROJECT_ID": "nexus-tcc-2026",
        "FIREBASE_AUTH_DOMAIN": "nexus-tcc-2026.firebaseapp.com",
        "FIREBASE_APP_ID": "1:208631748107:web:fbe678ca6f6762b898190e",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nexus-prod",
          "database_id": "79c154c6-4370-4833-ae68-029e05f39eef",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
